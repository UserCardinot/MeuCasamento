# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_FOTOS=
GOOGLE_DRIVE_FOLDER_AUDIOS=

# Pix (código copia e cola do banco para QR Code; chave para exibir)
PIX_COPIA_COLA=
PIX_CHAVE=

# Token da área de mídia (QR Code nas mesas)
EVENT_TOKEN=evt_xxx

# Admin (use uma senha forte e única)
ADMIN_PASSWORD=

# Mercado Pago (cartão) — use só o ACCESS TOKEN (nunca a Public Key)
#
# .env.local (localhost):
#   MERCADOPAGO_ACCESS_TOKEN = Access Token das "Credenciais de teste"
#   MERCADOPAGO_SANDBOX=true
#   (sem NEXT_PUBLIC_SITE_URL aqui)
#   Pagamento com cartões de teste do MP
#
# Vercel → Environment Variables → Production:
#   MERCADOPAGO_ACCESS_TOKEN = Access Token das "Credenciais de produção"
#   MERCADOPAGO_SANDBOX=false
#   NEXT_PUBLIC_SITE_URL=https://casamento-pink.vercel.app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
