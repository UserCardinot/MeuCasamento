# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_FOTOS=
GOOGLE_DRIVE_FOLDER_AUDIOS=

# Pix — para QR com valor fixo do carrinho, use PIX_CHAVE (ou deixe PIX_COPIA_COLA para extrair a chave)
# Nome/cidade aparecem no comprovante (máx. 25 / 15 caracteres, sem acento)
PIX_CHAVE=
PIX_RECEBEDOR_NOME=
PIX_CIDADE=
# Opcional: copia e cola estático do banco (sem valor fixo; só fallback legado no GET /api/pix-info)
PIX_COPIA_COLA=

# Token da área de mídia (QR Code nas mesas)
EVENT_TOKEN=evt_xxx

# Admin (use uma senha forte e única)
ADMIN_PASSWORD=

# Mercado Pago (cartão) — use só o ACCESS TOKEN (nunca a Public Key)
#
# .env.local (localhost):
#   MERCADOPAGO_ACCESS_TOKEN = Access Token das "Credenciais de teste"
#   MERCADOPAGO_SANDBOX=true
#   (sem NEXT_PUBLIC_SITE_URL aqui)
#   Pagamento com cartões de teste do MP
#
# Vercel → Environment Variables → Production:
#   MERCADOPAGO_ACCESS_TOKEN = Access Token das "Credenciais de produção"
#   MERCADOPAGO_SANDBOX=false
#   MERCADOPAGO_PRODUCAO_COLLECTOR_ID = número do vendedor em produção (veja na URL preference-id=NNNN-...)
#   NEXT_PUBLIC_SITE_URL=https://casamento-pink.vercel.app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
# MERCADOPAGO_PRODUCAO_COLLECTOR_ID=187991431
# Taxa embutida só no checkout com cartão (padrão 5). Use 0 para desativar.
# MERCADOPAGO_TAXA_PERCENT=5
#
# Webhook (painel MP → sua app → Webhooks): evento Pagamentos
# https://casamento-pink.vercel.app/api/webhooks/mercadopago
# E-mail do comprador de teste (painel → Contas de teste → Comprador), opcional mas ajuda
MERCADOPAGO_TEST_BUYER_EMAIL=
